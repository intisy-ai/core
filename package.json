{
  "name": "core",
  "version": "2.6.0",
  "description": "Shared config, logging, and app-detection foundation for the intisy-ai AI-proxy ecosystem.",
  "type": "module",
  "license": "MIT",
  "author": "intisy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intisy-ai/core.git"
  },
  "keywords": [
    "opencode",
    "claude",
    "core",
    "plugin",
    "commands",
    "config"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./runtime": {
      "default": "./dist/generated/runtime.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "emit": "node node_modules/@intisy-ai/api/scripts/emit-dts.mjs --java-dir . --module :contracts --module-dir contracts --out src/generated",
    "build": "npm run emit && npm run emit:teavm && npm run build:teavm && npm run build:classlib && tsc --emitDeclarationOnly && node build.mjs && node node_modules/@intisy-ai/api/scripts/copy-generated.mjs",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run build",
    "build:teavm": "node node_modules/@intisy-ai/api/scripts/teavm-build.mjs --java-dir . --module :core-teavm --out src/generated/core.teavm.js",
    "emit:teavm": "node node_modules/@intisy-ai/api/scripts/emit-dts.mjs --java-dir . --module :core-teavm --out src/generated",
    "docs": "typedoc",
    "build:classlib": "node node_modules/@intisy-ai/api/scripts/teavm-build.mjs --java-dir . --module :classlib --out src/generated/runtime.js"
  },
  "peerDependencies": {
    "vitest": ">=2"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@intisy-ai/api": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
